# Clerk development instance credentials. Obtain these from the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk sends team invitation emails with the server-side secret key above.
# Ensure the Clerk `convex` JWT template includes verified email, name, and phone claims.

# Public URL of the matching Convex environment. This is safe to expose to the browser.
NEXT_PUBLIC_CONVEX_URL=

# Public PostHog project settings. The project key is intentionally public;
# consent is required before this integration sends events.
NEXT_PUBLIC_POSTHOG_KEY=
# Required with the key. Supported ingest hosts are https://us.i.posthog.com
# and https://eu.i.posthog.com. Do not use the PostHog application URL.
NEXT_PUBLIC_POSTHOG_HOST=

# Deployment metadata added to every documented analytics event.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_RELEASE_SHA=
