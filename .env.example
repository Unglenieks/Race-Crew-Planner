# Convex CLI deployment selection for local development.
# Use this when a selected development deployment has already been configured.
CONVEX_SELF_HOSTED_URL=
CONVEX_DEPLOYMENT=

# Required with CONVEX_SELF_HOSTED_URL when targeting the self-hosted instance
# directly. Store its value in the relevant secret manager.
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Required only for non-interactive cloud deployment automation.
CONVEX_DEPLOY_KEY=

# Clerk Frontend API URL (for example, https://example.clerk.accounts.dev).
# Configure this as a Convex environment variable, never in browser code.
CLERK_JWT_ISSUER_DOMAIN=
