{
  "name": "race-planner",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "check:repo": "node scripts/check-repo.mjs",
    "dev": "pnpm --filter @race-planner/web dev",
    "build": "pnpm --filter @race-planner/web build",
    "lint": "pnpm --filter @race-planner/web lint",
    "typecheck": "pnpm --filter @race-planner/web typecheck",
    "test": "pnpm --filter @race-planner/web test && vitest run tests/convex",
    "format:check": "pnpm --filter @race-planner/web format:check",
    "convex:typecheck": "tsc --noEmit --project convex/tsconfig.json",
    "convex:codegen": "convex codegen --typecheck enable",
    "convex:dev": "convex dev --typecheck enable"
  },
  "devDependencies": {
    "@types/node": "^20",
    "convex": "1.43.0",
    "railway": "3.8.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
